# ============================================
# PORTFOLIO WEBSITE - ENVIRONMENT VARIABLES
# ============================================
# NEVER commit .env to git!

# ========== SERVER ==========
PORT=3000
NODE_ENV=production

# ========== WEBSITE ==========
WEBSITE_URL=https://ahmedportfolio.site

# ========== GEMINI AI (Chatbot) ==========
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: primary model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# ========== SMTP (Contact Form Emails) ==========
# Gmail SMTP — free, 500 emails/day
# App Password banane ke liye: Google Account > Security > 2-Step Verification ON >
# Security > App passwords > Mail > generate 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
ADMIN_EMAIL=your-gmail@gmail.com

# ========== PORTFOLIO DATA ==========
PORTFOLIO_DATA_URL=knowledge.json

# ========== DEBUG ==========
DEBUG=false
