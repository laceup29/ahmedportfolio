# ============================================
# PORTFOLIO WEBSITE - ENVIRONMENT VARIABLES
# ============================================
# NEVER commit .env to git!

# ========== SERVER ==========
PORT=3000
NODE_ENV=production

# ========== WEBSITE ==========
WEBSITE_URL=https://ahmedportfolio.site

# ========== GEMINI AI (Chatbot) ==========
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: primary model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# ========== PORTFOLIO DATA ==========
PORTFOLIO_DATA_URL=knowledge.json

# ========== DEBUG ==========
DEBUG=false
