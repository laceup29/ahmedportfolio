# ============================================
# PORTFOLIO WEBSITE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ========== SERVER ==========
PORT=3000
NODE_ENV=production

# ========== WEBSITE ==========
WEBSITE_URL=https://your-app.onrender.com

# ========== n8n WEBHOOK ==========
N8N_WEBHOOK_URL=https://n8n.srv1146250.hstgr.cloud/webhook/my_portfolio
CONTACT_WEBHOOK_URL=https://n8n.srv1146250.hstgr.cloud/webhook/Form_submit

# ========== PORTFOLIO DATA ==========
PORTFOLIO_DATA_URL=portfolio-data.json

# ========== EMAIL (Contact Form) ==========
# Gmail SMTP Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=your-email@gmail.com

# Hostinger SMTP Example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASS=your-password
# CONTACT_EMAIL=your-email@yourdomain.com

# ========== DEBUG ==========
DEBUG=false
